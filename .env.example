# Environment variables for ddharmon
# Copy this to .env and fill in your values

# =============================================================================
# Biomapper2 API Integration
# =============================================================================
# Biomapper2 provides entity resolution via hybrid search + normalization
# Required for demographics and entity mapping workflows
# API endpoint: https://biomapper.expertintheloop.io/api/v1
BIOMAPPER_API_KEY=your-biomapper-api-key-here
BIOMAPPER_BASE_URL=https://biomapper.expertintheloop.io/api/v1

# =============================================================================
# Kestrel API Integration
# =============================================================================
# Kestrel provides access to the KRAKEN biomedical knowledge graph
# Required for KG mapping capability
KESTREL_API_KEY=your-kestrel-api-key-here

# =============================================================================
# LLM Providers (for semantic matching)
# =============================================================================
# OpenAI - used for embeddings (text-embedding-ada-002) and LLM reranking
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here

# Anthropic - alternative LLM provider for reranking
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here

# =============================================================================
# Optional: VoyageAI for embeddings
# =============================================================================
# VoyageAI provides domain-specific embeddings (voyage-large-2, voyage-code-2)
# Alternative to OpenAI embeddings
VOYAGE_API_KEY=your-voyage-key-here

# =============================================================================
# Optional: Embedding Provider Selection
# =============================================================================
# Options: openai, voyageai, sentence-transformers
# Default: sentence-transformers (no API key required, runs locally)
EMBEDDING_PROVIDER=sentence-transformers

# =============================================================================
# Optional: LLM Provider Selection
# =============================================================================
# Options: openai, anthropic
# Default: openai
LLM_PROVIDER=openai
